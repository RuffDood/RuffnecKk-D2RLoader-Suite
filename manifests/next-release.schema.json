{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/RuffDood/RuffnecKk-D2RLoader-Suite/manifests/next-release.schema.json",
  "title": "RuffnecKk D2RLoader Suite next release registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "suite",
    "compatibility",
    "distribution",
    "policy",
    "components"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "suite": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "latestPublicVersion",
        "targetVersion",
        "status",
        "releaseReady",
        "owner",
        "decisionDate"
      ],
      "properties": {
        "id": { "const": "ruffneckk-d2rloader-suite" },
        "latestPublicVersion": { "$ref": "#/$defs/semver" },
        "targetVersion": { "$ref": "#/$defs/semver" },
        "status": { "enum": ["draft", "scope-locked", "qualifying", "package-ready", "published"] },
        "releaseReady": { "type": "boolean" },
        "owner": { "type": "string", "minLength": 1 },
        "decisionDate": { "type": "string", "format": "date" }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy", "channels", "releaseGate"],
      "properties": {
        "policy": { "const": "native-fingerprint-fail-closed" },
        "channels": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "gameVersion", "build", "status", "claim"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "gameVersion": { "type": "string", "minLength": 1 },
              "build": { "type": "integer", "minimum": 1 },
              "status": { "enum": ["pending", "qualified", "not-tested", "incompatible"] },
              "claim": { "type": "string", "minLength": 1 }
            }
          }
        },
        "releaseGate": { "type": "string", "minLength": 1 }
      }
    },
    "distribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "bundles", "expectedGithubAssets"],
      "properties": {
        "model": { "const": "modular-catalog" },
        "bundles": { "type": "integer", "minimum": 0 },
        "expectedGithubAssets": {
          "type": "object",
          "additionalProperties": false,
          "required": ["individualPluginArchives", "individualPatchFiles", "standaloneTools", "optionalBundles", "total"],
          "properties": {
            "individualPluginArchives": { "type": "integer", "minimum": 0 },
            "individualPatchFiles": { "type": "integer", "minimum": 0 },
            "standaloneTools": { "type": "integer", "minimum": 0 },
            "optionalBundles": { "type": "integer", "minimum": 0 },
            "total": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiredIncludedIds", "deniedIncludedIds", "allowlistRole", "changelogRole"],
      "properties": {
        "requiredIncludedIds": { "$ref": "#/$defs/idArray" },
        "deniedIncludedIds": { "$ref": "#/$defs/idArray" },
        "allowlistRole": { "type": "string", "minLength": 1 },
        "changelogRole": { "type": "string", "minLength": 1 }
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/component" }
    }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "idArray": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$" }
    },
    "gate": {
      "enum": ["passed", "pending", "blocked", "not-required"]
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "kind",
        "disposition",
        "changeType",
        "targetVersion",
        "versionStatus",
        "asset",
        "sourceRef",
        "releaseNoteCategory",
        "releaseNote",
        "decision",
        "gates"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$" },
        "name": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["plugin", "patch", "tool", "project"] },
        "disposition": { "enum": ["include", "remove", "defer"] },
        "changeType": { "enum": ["add", "update", "retain", "remove", "defer"] },
        "targetVersion": {
          "oneOf": [
            { "$ref": "#/$defs/semver" },
            { "type": "null" }
          ]
        },
        "versionStatus": { "enum": ["locked", "pending", "candidate", "needs-reconciliation", "not-applicable", "not-scheduled"] },
        "asset": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        },
        "sourceRef": { "type": "string", "minLength": 1 },
        "releaseNoteCategory": { "enum": ["Added", "Changed", "Fixed", "Removed", "Deferred"] },
        "releaseNote": { "type": "string", "minLength": 1 },
        "decision": { "type": "string", "minLength": 1 },
        "archiveReadme": {
          "type": "object",
          "additionalProperties": false,
          "required": ["include", "source", "destination", "sha256", "reviewedBy", "reviewedOn", "decision"],
          "properties": {
            "include": { "const": true },
            "source": { "type": "string", "pattern": "^plugins/[a-z0-9-]+/README\\.md$" },
            "destination": { "const": "README.md" },
            "sha256": { "type": "string", "pattern": "^[0-9A-F]{64}$" },
            "reviewedBy": { "type": "string", "minLength": 1 },
            "reviewedOn": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
            "decision": { "type": "string", "minLength": 1 }
          }
        },
        "archiveCompanions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "source", "destination", "sha256", "requiredForRuntime", "decision"],
            "properties": {
              "kind": { "const": "plugin-companion-exe" },
              "source": { "type": "string", "pattern": "^plugins/[A-Za-z0-9][A-Za-z0-9._-]*\\.exe$" },
              "destination": { "type": "string", "pattern": "^plugins/[A-Za-z0-9][A-Za-z0-9._-]*\\.exe$" },
              "sha256": { "type": "string", "pattern": "^[0-9A-F]{64}$" },
              "requiredForRuntime": { "const": true },
              "decision": { "type": "string", "minLength": 1 }
            }
          }
        },
        "archiveEmbedding": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ownerComponentId", "includeInBundles", "destinationDirectory", "executable", "readme", "decision"],
          "properties": {
            "ownerComponentId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$" },
            "includeInBundles": { "const": false },
            "destinationDirectory": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._-]*$" },
            "executable": {
              "type": "object",
              "additionalProperties": false,
              "required": ["source", "destination", "sha256"],
              "properties": {
                "source": { "type": "string", "pattern": "^tools/[A-Za-z0-9][A-Za-z0-9._-]*\\.exe$" },
                "destination": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._-]*/[A-Za-z0-9][A-Za-z0-9._-]*\\.exe$" },
                "sha256": { "type": "string", "pattern": "^[0-9A-F]{64}$" }
              }
            },
            "readme": {
              "type": "object",
              "additionalProperties": false,
              "required": ["source", "destination", "sha256", "reviewedBy", "reviewedOn"],
              "properties": {
                "source": { "type": "string", "pattern": "^tools/[a-z0-9-]+/README\\.md$" },
                "destination": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._-]*/README\\.md$" },
                "sha256": { "type": "string", "pattern": "^[0-9A-F]{64}$" },
                "reviewedBy": { "type": "string", "minLength": 1 },
                "reviewedOn": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
              }
            },
            "decision": { "type": "string", "minLength": 1 }
          }
        },
        "gates": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "build", "battleNetRuntime", "steamRuntime", "packaging"],
          "properties": {
            "source": { "$ref": "#/$defs/gate" },
            "build": { "$ref": "#/$defs/gate" },
            "battleNetRuntime": { "$ref": "#/$defs/gate" },
            "steamRuntime": { "$ref": "#/$defs/gate" },
            "packaging": { "$ref": "#/$defs/gate" }
          }
        }
      }
    }
  }
}
