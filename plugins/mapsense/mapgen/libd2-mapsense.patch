@@ -321,0 +322,79 @@ var g_blobState = std.atomic.Value(u8).init(0); // 0 uninit, 1 building, 2 ready
+
+const MAX_DS1_OVERLAY_ROOTS: usize = 4;
+const MAX_DS1_OVERLAY_PATH: usize = 32 * 1024;
+const MAX_DS1_OVERLAY_BYTES: usize = 8 * 1024 * 1024;
+var g_ds1_overlay_roots: [MAX_DS1_OVERLAY_ROOTS][]const u8 =
+    .{"", "", "", ""};
+var g_ds1_overlay_root_count: usize = 0;
+
+fn isAbsoluteOverlayRoot(root: []const u8) bool {
+    if (root.len >= 3 and std.ascii.isAlphabetic(root[0])
+        and root[1] == ':' and (root[2] == '/' or root[2] == '\\')) {
+        return true;
+    }
+    return root.len >= 2
+        and ((root[0] == '\\' and root[1] == '\\')
+            or (root[0] == '/' and root[1] == '/'));
+}
+
+fn isSafeAssetRelative(rel: []const u8) bool {
+    if (rel.len == 0 or rel.len >= MAX_DS1_OVERLAY_PATH
+        or rel[0] == '/' or rel[0] == '\\'
+        or std.mem.indexOfScalar(u8, rel, ':') != null
+        or std.mem.indexOfScalar(u8, rel, 0) != null) {
+        return false;
+    }
+    var segment_start: usize = 0;
+    var index: usize = 0;
+    while (index <= rel.len) : (index += 1) {
+        if (index != rel.len and rel[index] != '/' and rel[index] != '\\') {
+            continue;
+        }
+        const segment = rel[segment_start..index];
+        if (segment.len == 0 or std.mem.eql(u8, segment, ".")
+            or std.mem.eql(u8, segment, "..")) {
+            return false;
+        }
+        segment_start = index + 1;
+    }
+    return true;
+}
+
+/// Configure ordered active-mod tile roots. The helper process owns the root
+/// strings and invokes this once before generation; missing files fall through
+/// to the embedded vanilla DS1 blob.
+pub fn configureDs1OverlayRoots(roots: []const []const u8) bool {
+    if (roots.len > g_ds1_overlay_roots.len) return false;
+    for (roots) |root| {
+        if (root.len == 0 or root.len >= MAX_DS1_OVERLAY_PATH
+            or std.mem.indexOfScalar(u8, root, 0) != null
+            or !isAbsoluteOverlayRoot(root)) {
+            return false;
+        }
+    }
+    g_ds1_overlay_roots = .{"", "", "", ""};
+    for (roots, 0..) |root, index| g_ds1_overlay_roots[index] = root;
+    g_ds1_overlay_root_count = roots.len;
+    last_ds1_key = "";
+    last_ds1 = null;
+    return true;
+}
+
+fn unpackOverlayDs1(a: std.mem.Allocator, rel: []const u8) ?ds1mod.Ds1 {
+    if (g_ds1_overlay_root_count == 0 or !isSafeAssetRelative(rel)) {
+        return null;
+    }
+    var threaded = std.Io.Threaded.init_single_threaded;
+    const io = threaded.io();
+    for (g_ds1_overlay_roots[0..g_ds1_overlay_root_count]) |root| {
+        var pathbuf: [MAX_DS1_OVERLAY_PATH]u8 = undefined;
+        const full = std.fmt.bufPrint(
+            &pathbuf, "{s}/{s}", .{ root, rel }) catch continue;
+        const bytes = std.Io.Dir.cwd().readFileAlloc(
+            io, full, a, .limited(MAX_DS1_OVERLAY_BYTES)) catch continue;
+        defer a.free(bytes);
+        return ds1mod.parse(a, bytes) catch continue;
+    }
+    return null;
+}
