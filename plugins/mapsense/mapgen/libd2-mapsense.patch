+/// Decodes MaxiMap once into one fixed palette-index atlas. Keeping palette
+/// indices makes the persisted package compact while retaining D2's exact
+/// per-act colours; the plugin expands the five palettes during GPU setup.
+pub fn loadAutomapSpriteAtlas(alloc: std.mem.Allocator) !AutomapSpriteAtlas {
+    const frame_width: u16 = 16;
+    const frame_height: u16 = 32;
+    const columns: u16 = 64;
+    const rows: u16 = 24;
+    const atlas_width: u32 = frame_width * columns;
+    const atlas_height: u32 = frame_height * rows;
+
+    var blob = try automap_blob.parse(alloc, automap_data.bytes);
+    defer blob.deinit();
+    if (blob.palettes.len != 5) return error.InvalidAutomapPaletteCount;
+    const bytes = blob.layer("MaxiMap") orelse return error.MissingAutomapLayer;
+    var sheet = try d2formats.dc6.parse(alloc, bytes);
+    defer sheet.deinit();
+    if (sheet.frames.len == 0 or sheet.frames.len > @as(usize, columns) * rows) {
+        return error.InvalidAutomapFrameCount;
+    }
+
+    const palettes = try alloc.alloc(u8, 5 * automap_blob.PALETTE_LEN);
+    errdefer alloc.free(palettes);
+    for (blob.palettes, 0..) |palette, act| {
+        if (palette.len != automap_blob.PALETTE_LEN) {
+            return error.InvalidAutomapPalette;
+        }
+        @memcpy(
+            palettes[act * automap_blob.PALETTE_LEN ..][0..automap_blob.PALETTE_LEN],
+            palette,
+        );
+    }
+
+    const indices = try alloc.alloc(u8, @as(usize, atlas_width) * atlas_height);
+    errdefer alloc.free(indices);
+    @memset(indices, 0);
+    for (sheet.frames, 0..) |frame, frame_index| {
+        if (frame.width != frame_width or frame.height != frame_height or frame.offset_x != 0 or frame.offset_y != 0 or frame.indices.len != @as(usize, frame_width) * frame_height) {
+            return error.UnsupportedAutomapFrameLayout;
+        }
+        const cell_x = (frame_index % columns) * frame_width;
+        const cell_y = (frame_index / columns) * frame_height;
+        var y: usize = 0;
+        while (y < frame_height) : (y += 1) {
+            const destination = (cell_y + y) * atlas_width + cell_x;
+            const source = y * frame_width;
+            @memcpy(
+                indices[destination..][0..frame_width],
+                frame.indices[source..][0..frame_width],
+            );
+        }
+    }
+    return .{
+        .palettes = palettes,
+        .indices = indices,
+        .frame_count = @intCast(sheet.frames.len),
+        .frame_width = frame_width,
+        .frame_height = frame_height,
+        .columns = columns,
+        .rows = rows,
+        .atlas_width = atlas_width,
+        .atlas_height = atlas_height,
+        .allocator = alloc,
+    };
+}
+
+/// Returns bounded MaxiMap frame metadata without exposing the embedded blob.
+/// This is used by the external MapSense packager to choose a texture layout;
+/// gameplay atlas generation remains independent from sprite packaging.
+pub fn loadAutomapSpriteStats(alloc: std.mem.Allocator) !AutomapSpriteStats {
+    var blob = try automap_blob.parse(alloc, automap_data.bytes);
+    defer blob.deinit();
+    const bytes = blob.layer("MaxiMap") orelse return error.MissingAutomapLayer;
+    var sheet = try d2formats.dc6.parse(alloc, bytes);
+    defer sheet.deinit();
+    const frames = try alloc.alloc(AutomapSpriteFrameInfo, sheet.frames.len);
+    errdefer alloc.free(frames);
+    for (sheet.frames, 0..) |frame, index| {
+        var opaque_count: u32 = 0;
+        for (frame.indices) |pixel| {
+            if (pixel != 0) opaque_count += 1;
+        }
+        frames[index] = .{
+            .width = frame.width,
+            .height = frame.height,
+            .offset_x = frame.offset_x,
+            .offset_y = frame.offset_y,
+            .opaque_pixels = opaque_count,
+        };
+    }
+    return .{ .frames = frames, .allocator = alloc };
+}
