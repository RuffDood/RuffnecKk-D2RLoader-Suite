+/// Replays only the first outdoor waypoint-substitution placement for one
+/// generated room. It creates the small pre-placement floor/wall grids needed
+/// by CheckSubTileOverlap, but deliberately stops before tile materialization,
+/// collision, shrine/terrain passes, object population or monster generation.
+/// The selected file and source/destination boxes let a caller transform the
+/// DS1 waypoint object's subtile coordinate exactly.
+pub fn locateOutdoorWaypointPlacement(
+    ws_x: i32,
+    ws_y: i32,
+    level_id: i32,
+    room_seed: i32,
+    overlay: ?OutdoorOverlay,
+    waypoint_mask: i32,
+) !?SubTilePlacement {
+    if (waypoint_mask == 0) return null;
+    const ar = roomScratch(&scratch_outdoor_room);
+    const gw: usize = @intCast(ws_x + 1);
+    const gh: usize = @intCast(ws_y + 1);
+    const ncells = gw * gh;
+
+    var level = std.mem.zeroes(s.D2DrlgLevelStrc);
+    level.eD2LevelId = @enumFromInt(level_id);
+    var room = std.mem.zeroes(s.D2RoomExStrc);
+    room.pLevel = &level;
+    room.sSeed = .{ .nSeedLow = room_seed, .nSeedHigh = 0x29a };
+    room.sCoords = .{
+        .WorldPosition = .{ .x = 0, .y = 0 },
+        .WorldSize = .{ .x = ws_x, .y = ws_y },
+    };
+
+    const floor_cells = try ar.alloc(i32, ncells);
+    @memset(floor_cells, 0);
+    var fg = try buildGrid(ar, gw, gh, floor_cells);
+    const wall_cells = try ar.alloc(i32, ncells);
+    @memset(wall_cells, 0);
+    var wg = try buildGrid(ar, gw, gh, wall_cells);
+    const orient_cells = try ar.alloc(i32, ncells);
+    @memset(orient_cells, 0);
+    var og = try buildGrid(ar, gw, gh, orient_cells);
+
+    var yy: i32 = 0;
+    while (yy < 8 and yy < ws_y) : (yy += 1) {
+        var xx: i32 = 0;
+        while (xx < 8 and xx < ws_x) : (xx += 1) {
+            DrlgGrid.AlterGridFlag(&fg.grid, xx, yy, 0x40002, 3);
+        }
+    }
+    if (overlay) |ov| try applyAct1WallOverlay(ar, &fg, ov, ws_x, ws_y);
+
+    const pDef = dtables.levelDefsGetLine(@enumFromInt(level_id));
+    if (pDef.*.SubWaypoint == -1) return null;
+    var mask: u32 = @bitCast(waypoint_mask);
+    var pLine = dtables.lvlSubGetLineFromSubType(pDef.*.SubWaypoint);
+    if (pLine == null) return null;
+    while (mask != 0) : ({
+        mask >>= 1;
+        pLine += 1;
+    }) {
+        if (mask & 1 == 0) continue;
+        const pRec: *dtables.D2LvlSubTxt = @ptrCast(pLine);
+        TileSub.InitializeDrlgFile(null, pRec);
+        if (pRec.pDrlgFile == null or pRec.CheckAll != 0) continue;
+        var placement: ?SubTilePlacement = null;
+        doNotCheckAll(&room, &fg.grid, &wg.grid, &og.grid, pRec, 0, &placement);
+        if (placement != null) return placement;
+    }
+    return null;
+}
