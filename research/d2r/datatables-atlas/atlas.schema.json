{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ruffneckk.example/schemas/d2r33-datatables-atlas-v1.json",
  "title": "RuffnecKk D2R 3.3 DataTables Atlas",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "catalogId",
    "targetRuntime",
    "corpus",
    "dataTables",
    "scope",
    "evidence",
    "tables"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "catalogId": { "const": "ruffneckk-d2r33-datatables-atlas-v1" },
    "targetRuntime": { "$ref": "#/definitions/runtime" },
    "corpus": { "$ref": "#/definitions/corpus" },
    "dataTables": { "$ref": "#/definitions/dataTables" },
    "scope": { "$ref": "#/definitions/scope" },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/evidence" }
    },
    "tables": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/table" }
    }
  },
  "definitions": {
    "hex": {
      "type": "string",
      "pattern": "^0x(?:0|[1-9A-F][0-9A-F]*)$"
    },
    "status": {
      "type": "string",
      "enum": ["proven", "candidate", "unknown"]
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "build", "architecture"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "build": { "type": "integer", "minimum": 1 },
        "architecture": { "const": "x86-64" }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["build", "status", "evidenceIds"],
      "properties": {
        "build": { "type": "integer", "minimum": 1 },
        "status": { "const": "byte-exact" },
        "evidenceIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "corpus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workbenchPath",
        "provenanceBuild",
        "imageBase",
        "canonicalImageSha256",
        "analysisImageSha256",
        "coveredBuilds"
      ],
      "properties": {
        "workbenchPath": { "type": "string", "minLength": 1 },
        "provenanceBuild": { "type": "integer", "minimum": 1 },
        "imageBase": { "$ref": "#/definitions/hex" },
        "canonicalImageSha256": { "type": "string", "pattern": "^[0-9A-F]{64}$" },
        "analysisImageSha256": { "type": "string", "pattern": "^[0-9A-F]{64}$" },
        "coveredBuilds": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/coverage" }
        }
      }
    },
    "dataTables": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accessorRva", "contextCount", "globalEntryStride", "evidenceIds"],
      "properties": {
        "accessorRva": { "$ref": "#/definitions/hex" },
        "contextCount": { "type": "integer", "minimum": 1 },
        "globalEntryStride": { "$ref": "#/definitions/hex" },
        "evidenceIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expectedTableIds", "excluded"],
      "properties": {
        "expectedTableIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
        },
        "excluded": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "path", "supports", "claims"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "kind": {
          "type": "string",
          "enum": ["known-rva", "native-site", "json-pointer", "text-witness"]
        },
        "path": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "siteId": { "type": "string", "minLength": 1 },
        "rva": { "$ref": "#/definitions/hex" },
        "pointer": { "type": "string", "pattern": "^/" },
        "expected": {},
        "needle": { "type": "string", "minLength": 1 },
        "supports": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "claims": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {}
        },
        "notes": { "type": "string", "minLength": 1 }
      }
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidenceIds"],
      "properties": {
        "status": { "$ref": "#/definitions/status" },
        "value": { "$ref": "#/definitions/hex" },
        "evidenceIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "notes": { "type": "string", "minLength": 1 }
      }
    },
    "recordField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "offset", "size", "type", "status", "evidenceIds"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "name": { "type": "string", "minLength": 1 },
        "offset": { "$ref": "#/definitions/hex" },
        "size": { "type": "integer", "minimum": 1 },
        "type": { "type": "string", "minLength": 1 },
        "status": { "$ref": "#/definitions/status" },
        "evidenceIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "notes": { "type": "string", "minLength": 1 }
      }
    },
    "postProcessing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "summary", "evidenceIds"],
      "properties": {
        "status": { "$ref": "#/definitions/status" },
        "summary": { "type": "string", "minLength": 1 },
        "evidenceIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "table": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "displayName",
        "sourceTables",
        "records",
        "count",
        "recordSize",
        "recordFields",
        "postProcessing"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "displayName": { "type": "string", "minLength": 1 },
        "sourceTables": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "records": { "$ref": "#/definitions/fact" },
        "count": { "$ref": "#/definitions/fact" },
        "linker": { "$ref": "#/definitions/fact" },
        "recordSize": { "$ref": "#/definitions/fact" },
        "recordFields": {
          "type": "array",
          "items": { "$ref": "#/definitions/recordField" }
        },
        "postProcessing": { "$ref": "#/definitions/postProcessing" },
        "notes": { "type": "string", "minLength": 1 }
      }
    }
  }
}
