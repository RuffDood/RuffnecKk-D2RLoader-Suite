{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ruffneckk.local/schemas/d2rloader-baselines.schema.json",
  "title": "RuffnecKk D2RLoader baseline registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "generatedAt",
    "promotedBaselineId",
    "policy",
    "baselines"
  ],
  "properties": {
    "$schema": {
      "const": "./d2rloader-baselines.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "promotedBaselineId": {
      "type": "string",
      "minLength": 1
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowVersionBasedRuntimeGate",
        "promotionRequiresQualification",
        "keepHistory"
      ],
      "properties": {
        "allowVersionBasedRuntimeGate": {
          "const": false
        },
        "promotionRequiresQualification": {
          "const": true
        },
        "keepHistory": {
          "const": true
        }
      }
    },
    "baselines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/baseline"
      }
    }
  },
  "$defs": {
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence"],
      "properties": {
        "status": {
          "enum": ["not-run", "passed", "failed", "blocked", "not-required"]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "size", "sha256", "fileVersion", "evidencePath"],
      "properties": {
        "name": {
          "enum": ["D2RLoader.exe", "D2RCore.dll", "d2rloader.mpq"]
        },
        "size": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9A-F]{64}$"
        },
        "fileVersion": {
          "type": ["string", "null"]
        },
        "evidencePath": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "sdkPin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "tag", "commit", "role", "repository"],
      "properties": {
        "apiVersion": {
          "type": "integer",
          "minimum": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "role": {
          "enum": ["existing-component-default", "capability-opt-in", "required"]
        },
        "repository": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "channel",
        "stage",
        "observedAt",
        "promotedAt",
        "supersededAt",
        "source",
        "artifacts",
        "sdk",
        "contracts",
        "impactReview",
        "gates",
        "notes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]*$"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "channel": {
          "enum": ["public", "preview", "beta", "nightly", "custom"]
        },
        "stage": {
          "enum": [
            "announced",
            "source-verified",
            "audited",
            "runtime-qualified",
            "promoted",
            "superseded"
          ]
        },
        "observedAt": {
          "type": "string",
          "format": "date"
        },
        "promotedAt": {
          "type": ["string", "null"],
          "format": "date"
        },
        "supersededAt": {
          "type": ["string", "null"],
          "format": "date"
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "url", "verifiedAt", "evidence"],
          "properties": {
            "kind": {
              "enum": ["official-release", "official-preview", "local-audit", "user-announcement"]
            },
            "url": {
              "type": "string",
              "format": "uri"
            },
            "verifiedAt": {
              "type": ["string", "null"],
              "format": "date"
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "artifacts": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/artifact"
          }
        },
        "sdk": {
          "type": "object",
          "additionalProperties": false,
          "required": ["selectionPolicy", "pins"],
          "properties": {
            "selectionPolicy": {
              "const": "minimum-required-capability"
            },
            "pins": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/sdkPin"
              }
            }
          }
        },
        "contracts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reviewed",
            "pluginManifestVersion",
            "requiredExports",
            "runtimeSelectionPolicy"
          ],
          "properties": {
            "reviewed": {
              "type": "boolean"
            },
            "pluginManifestVersion": {
              "type": ["integer", "null"],
              "minimum": 1
            },
            "requiredExports": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "runtimeSelectionPolicy": {
              "const": "native-fingerprint-only"
            }
          }
        },
        "impactReview": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["component", "disposition", "evidence"],
            "properties": {
              "component": {
                "type": "string",
                "minLength": 1
              },
              "disposition": {
                "enum": [
                  "unaffected",
                  "retest-only",
                  "rebuild",
                  "adapted",
                  "blocked",
                  "superseded-by-loader"
                ]
              },
              "evidence": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "gates": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sourceVerified",
            "artifactIntegrity",
            "sdkAudit",
            "contractAudit",
            "staticCompatibility",
            "runtimeQualification",
            "fullStackCoexistence",
            "multiplayer"
          ],
          "properties": {
            "sourceVerified": {"$ref": "#/$defs/gate"},
            "artifactIntegrity": {"$ref": "#/$defs/gate"},
            "sdkAudit": {"$ref": "#/$defs/gate"},
            "contractAudit": {"$ref": "#/$defs/gate"},
            "staticCompatibility": {"$ref": "#/$defs/gate"},
            "runtimeQualification": {"$ref": "#/$defs/gate"},
            "fullStackCoexistence": {"$ref": "#/$defs/gate"},
            "multiplayer": {"$ref": "#/$defs/gate"}
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
